# ===== QuadranGIS environment =====
# Salin ke .env lalu sesuaikan.

# --- Port di host (ubah bila bentrok dengan layanan lain) ---
HTTPS_PORT=443
HTTP_PORT=80
BACKEND_PORT=8080

# --- Backend ---
APP_ENV=development
HTTP_ADDR=:8080
# Jika diisi, backend melayani HTTPS langsung (selain via nginx)
TLS_CERT=
TLS_KEY=

# Di dalam Docker: postgres:5432. Dari host (dev lokal): localhost:5434
DATABASE_URL=postgres://quadran:quadran@postgres:5432/quadrangis?sslmode=disable
# Di dalam Docker: redis:6379. Dari host: localhost:6380
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

KAFKA_ENABLED=true
# Di dalam Docker: kafka:9092. Dari host: localhost:29093
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=quadran.gis.events
KAFKA_GROUP_ID=quadran-gis-worker

JWT_SECRET=ganti-dengan-secret-panjang-acak
JWT_TTL_HOURS=12
# true bila diakses lewat HTTPS (nginx). false untuk dev http://localhost:3000
COOKIE_SECURE=true

# Akun admin awal (dibuat otomatis jika tabel users kosong)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin#12345

CORS_ORIGINS=https://localhost,http://localhost:3000

# --- Frontend ---
# Kosongkan jika FE dan BE berada di origin yang sama (via nginx)
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_WS_URL=
# URL backend yang dipakai rewrite Next.js saat dev (tanpa nginx)
BACKEND_INTERNAL_URL=http://backend:8080
